    margin: 0 auto;
    padding: 96px 24px;
    color: var(--color-ink);
  }
  .not-found h1 {
    font-size: 32px;
    margin-bottom: 12px;
  }
  .not-found a {
    text-decoration: underline;
  }
</style>
